{
  "version": 5,
  "configurePresets": [
    {
      "name": "gcc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "C:/GCC/ucrt64/bin/g++.exe",
        "CMAKE_RC_COMPILER": "C:/GCC/ucrt64/bin/windres.exe",
        "CMAKE_MAKE_PROGRAM": "C:/GCC/ucrt64/bin/ninja.exe",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist"
      },
      "environment": { "PATH": "C:/GCC/ucrt64/bin;$penv{PATH}" }
    },
    {
      "name": "gcc-debug",
      "inherits": "gcc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "gcc-release",
      "inherits": "gcc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "gcc-debug" },
    { "name": "release", "configurePreset": "gcc-release" }
  ]
}

