#include <windows.h>
#include "resource.h"

IDI_APP_ICON ICON "app.ico"
1 RT_MANIFEST "app.manifest"
2000 RCDATA "third_party_notices.txt"

IDD_STYLE_NAME DIALOGEX 0, 0, 290, 112
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_COMPOSITED
CAPTION "Style name"
FONT 9, "Microsoft YaHei UI"
BEGIN
  LTEXT "", IDC_STYLE_NAME_HINT, 10, 10, 270, 38, SS_NOPREFIX | SS_NOTIFY
  EDITTEXT IDC_STYLE_NAME, 10, 50, 270, 16, ES_AUTOHSCROLL | WS_TABSTOP
  CONTROL "OK", IDOK, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 166, 84, 54, 20
  CONTROL "Cancel", IDCANCEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 226, 84, 54, 20
END

IDD_MATERIALS DIALOGEX 0, 0, 420, 270
STYLE DS_CONTROL | DS_SETFONT | WS_CHILD | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Advanced materials"
FONT 9, "Microsoft YaHei UI"
BEGIN
  LTEXT "", IDC_MATERIAL_TITLE, 14, 12, 350, 26
  LTEXT "", IDC_MATERIAL_PATH_LABEL, 14, 48, 200, 12
  EDITTEXT IDC_MATERIAL_PATH, 14, 66, 152, 20, ES_AUTOHSCROLL | WS_TABSTOP
  CONTROL "Browse", IDC_MATERIAL_BROWSE, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 172, 66, 52, 20
  CONTROL "Import", IDC_MATERIAL_IMPORT, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 50, 114, 138, 22
  CONTROL "Refresh", IDC_MATERIAL_REFRESH, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 14, 114, 32, 22
  CONTROL "", IDC_MATERIAL_LIST, "LISTBOX", WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_TABSTOP | LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT, 252, 72, 144, 120
  LTEXT "", IDC_MATERIAL_IMPORT_HINT, 30, 96, 180, 16, SS_CENTER
  LTEXT "", IDC_MATERIAL_FORMATS, 14, 150, 210, 22
  LTEXT "", IDC_MATERIAL_STATUS, 14, 184, 210, 28, SS_LEFTNOWORDWRAP | SS_ENDELLIPSIS | SS_NOPREFIX | SS_NOTIFY
  LTEXT "", IDC_MATERIAL_PREVIEW_LABEL, 252, 50, 144, 16
  CONTROL "", IDC_MATERIAL_PREVIEW, "STATIC", SS_OWNERDRAW, 252, 72, 144, 120
  LTEXT "", IDC_MATERIAL_DETAILS, 252, 198, 144, 28, SS_NOPREFIX | SS_NOTIFY
  LTEXT "", IDC_MATERIAL_PREVIEW_HINT, 252, 224, 144, 16
  LTEXT "", IDC_MATERIAL_HINT, 14, 246, 210, 16
  CONTROL "Cancel", IDCANCEL, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 298, 244, 48, 20
  CONTROL "Save", IDOK, "BUTTON", BS_OWNERDRAW | WS_TABSTOP, 352, 244, 54, 20
END

1 VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "MouseCursorDetector\0"
      VALUE "FileVersion", "0.1.0\0"
      VALUE "ProductName", "MouseCursorDetector\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
